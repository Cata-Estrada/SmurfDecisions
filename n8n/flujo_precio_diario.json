      "id": "44e5f08b-81af-5f08-a4f6-c2759d556e4b",
      "name": "Bolsa Nueva York (Yahoo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        100
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true
    },
    {
      "parameters": {
        "url": "https://www.datos.gov.co/resource/32sa-8pi3.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$where",
              "value": "=vigenciadesde <= '{{ $now.setZone('America/Bogota').toFormat('yyyy-MM-dd') }}T00:00:00.000'"
            },
            {
              "name": "$order",
              "value": "vigenciadesde DESC"
            },
            {
              "name": "$limit",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "23af5e20-51eb-5c9b-b6f8-78f8eb52b331",
      "name": "TRM oficial",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        100
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Toma el último cierre de Yahoo (CC=F) y la TRM vigente, y arma una fila por indicador.\nconst fechaBogota = ms => new Date(ms - 5 * 60 * 60 * 1000).toISOString().slice(0, 10);\nconst filas = [];\nconst errores = [];\n\ntry {\n  const r = $('Bolsa Nueva York (Yahoo)').first().json.chart.result[0];\n  const tiempos = r.timestamp || [];\n  const cierres = r.indicators.quote[0].close || [];\n  for (let k = tiempos.length - 1; k >= 0; k--) {\n    if (Number(cierres[k]) > 0) {\n      filas.push({ indicador_codigo: 'CACAO_NY', fecha: fechaBogota(tiempos[k] * 1000),\n        valor: Number(cierres[k]), fuente: 'Yahoo Finance · CC=F' });\n      break;\n    }\n  }\n  if (!filas.length) errores.push('Yahoo no devolvió cierres');\n} catch (e) { errores.push('Yahoo: ' + e.message); }\n\ntry {\n  const t = $('TRM oficial').first().json;\n  const valor = Number(t.valor);\n  if (valor > 0) {\n    filas.push({ indicador_codigo: 'TRM', fecha: String(t.vigenciadesde).slice(0, 10),\n      valor, fuente: 'Superintendencia Financiera · datos.gov.co' });\n  } else errores.push('TRM sin valor');\n} catch (e) { errores.push('TRM: ' + e.message); }\n\nreturn filas.length\n  ? filas.map(f => ({ json: { ...f, errores: errores.join('; ') } }))\n  : [{ json: { sin_datos: true, errores: errores.join('; ') } }];\n"
      },
      "id": "51d1335a-f5e5-57eb-beff-06c02947bfa3",
      "name": "Armar valores",
      "type": "n8n-nodes-base.code",
