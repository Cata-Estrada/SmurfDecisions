{
  "name": "SmurfDecisions - Flujo 1: Indicadores Diarios TRM",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "node-schedule",
      "name": "Consulta Diaria (7:00 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "https://www.datos.gov.co/resource/32sa-8pi3.json?$order=vigenciadesde%20DESC&$limit=10",
        "options": {}
      },
      "id": "node-http-trm",
      "name": "Consultar TRM Datos Abiertos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extraer y normalizar los datos de la Superfinanciera\nconst items = $input.all();\nif (!items || items.length === 0) {\n  throw new Error('No se recibieron datos de la Superfinanciera');\n}\n\nconst reciente = items[0].json;\nconst valorActual = parseFloat(reciente.valor);\nconst fechaActual = reciente.vigenciadesde ? reciente.vigenciadesde.substring(0, 10) : new Date().toISOString().substring(0, 10);\n\n// Comparar con valor de 5 días hábiles atrás (índice 5 si está disponible)\nlet alertaVariacion = false;\nlet variacionPct = 0;\nif (items.length >= 6) {\n  const valorAnterior = parseFloat(items[5].json.valor);\n  variacionPct = Math.abs(((valorActual - valorAnterior) / valorAnterior) * 100);\n  if (variacionPct > 3) {\n    alertaVariacion = true;\n  }\n}\n\nreturn [{\n  json: {\n    indicador_codigo: 'TRM',\n    fecha: fechaActual,\n    valor: valorActual,\n    fuente: 'Superfinanciera / Datos Abiertos Colombia',\n    alertaVariacion,\n    variacionPct: Number(variacionPct.toFixed(2))\n  }\n}];"
      },
      "id": "node-procesar-trm",
      "name": "Validar y Evaluar Variación > 3%",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "operation": "upsert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "valores_indicador",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "indicador_codigo": "={{ $json.indicador_codigo }}",
            "fecha": "={{ $json.fecha }}",
            "valor": "={{ $json.valor }}",
            "fuente": "={{ $json.fuente }}"
          }
        }
      },
      "id": "node-supabase-insert-trm",
      "name": "Guardar en Supabase (valores_indicador)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [880, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $('Validar y Evaluar Variación > 3%').item.json.alertaVariacion }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-if-alerta",
      "name": "¿Variación > 3%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "alertas",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "titulo": "=Alerta Cambiaria: TRM varió {{ $('Validar y Evaluar Variación > 3%').item.json.variacionPct }}% en 5 días hábiles",
            "resumen": "=La TRM registró un valor de ${{ $('Validar y Evaluar Variación > 3%').item.json.valor }} con una fluctuación superior al umbral crítico del 3%.",
            "enlace": "=https://www.datos.gov.co/resource/32sa-8pi3.json?fecha={{ $('Validar y Evaluar Variación > 3%').item.json.fecha }}",
            "fuente": "Superfinanciera",
            "fecha_publicacion": "={{ $('Validar y Evaluar Variación > 3%').item.json.fecha }}",
            "factor": "Económico",
            "area": "Compras y finanzas",
            "tipo_evento": "tasa_cambio",
            "probabilidad": 5,
            "impacto": 3,
            "puntaje": 15,
            "nivel": "Alto",
            "prioritaria": true,
            "estado": "pendiente",
            "decision": "pendiente",
            "origen": "n8n",
            "explicacion": "Impacto directo en sobrecosto de compras en dólares e insumos importados para planta Yumbo."
          }
        }
      },
      "id": "node-supabase-insert-alerta",
      "name": "Crear Alerta Económica (Puntaje 15)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1320, 220]
    },
    {
